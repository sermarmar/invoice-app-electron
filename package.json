{
  "name": "invoice-app-electron",
  "version": "1.0.0",
  "description": "Gestor de facturas en multiplataforma.",
  "main": "main.js",
  "scripts": {
    "postinstall": "electron-builder install-app-deps && cd backend && npm install",
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder --publish=never",
    "build:win": "electron-builder --win --publish=never",
    "build:mac": "electron-builder --mac --publish=never",
    "build:linux": "electron-builder --linux --publish=never",
    "build:all": "npm run build:$(node -e \"console.log(process.platform === 'darwin' ? 'mac' : process.platform === 'win32' ? 'win' : 'linux')\")"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.2",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sermarmar/invoice-app-electron.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "build": {
    "appId": "com.invoice.electron",
    "productName": "Invoice App",
    "directories": {
      "output": "dist"
    },
    "buildDependenciesFromSource": true,
    "files": [
      "main.js",
      "preload.js",
      "frontend/**/*"
    ],
    "extraResources": [
      {
        "from": "backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!node_modules/electron/**",
          "!node_modules/electron-builder/**",
          "!node_modules/.cache/**"
        ]
      }
    ],
    "afterPack": "./afterPack.js",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.business"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "bugs": {
    "url": "https://github.com/sermarmar/invoice-app-electron/issues"
  },
  "homepage": "https://github.com/sermarmar/invoice-app-electron#readme"
}
